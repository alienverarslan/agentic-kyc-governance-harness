# LLM provider selection. Only "anthropic" is implemented in slice-1.
# The factory raises a clear NotImplementedError for any other value.
LLM_PROVIDER=anthropic

# Required ONLY for the live end-to-end run and for POST /screen against the real model.
# All unit tests and the default eval run work WITHOUT this key (they use a stub LLM).
ANTHROPIC_API_KEY=

# Model + sampling are pinned for reproducibility (temperature 0).
# (These are defaults baked into the anthropic client; shown here for visibility.)
# ANTHROPIC_MODEL=claude-sonnet-4-6
